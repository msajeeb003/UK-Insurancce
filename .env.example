# ── Copy this file to `.env` and fill in real values. Never commit `.env`. ──

# ── LLM provider ──────────────────────────────────────────────────────
# auto = OpenAI when its key is set, else the Claude API. Or pin one:
# LLM_PROVIDER=openai | anthropic
LLM_PROVIDER=auto

# OpenAI — Structured Output extraction
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-2024-08-06

# Claude API (Anthropic) — structured-output extraction alternative
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Azure AI Document Intelligence — used as OCR fallback for scanned / table-heavy PDFs
AZURE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_KEY=<your-azure-document-intelligence-key>

# Pipeline tuning (optional — sensible defaults are applied if omitted)
# Minimum extractable characters per page before a page counts as "digital"
DIGITAL_MIN_CHARS_PER_PAGE=150
# If this fraction of pages (or more) fails the digital check, route to Azure OCR
SCANNED_PAGE_RATIO=0.4
# Hard cap on upload size in megabytes
MAX_UPLOAD_MB=25
# Reject PDFs longer than this before any paid API call
MAX_PDF_PAGES=60

# ── Deployment (BRD 2.9/2.10/2.11) ──────────────────────────────
# First user, seeded on startup when no users exist (no self-registration).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SQLite DB + retained documents + exports (default: <repo>/data)
DATA_DIR=
# Set true behind HTTPS in production
COOKIE_SECURE=false
SESSION_TTL_HOURS=72
